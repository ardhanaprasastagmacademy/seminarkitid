---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { getProducts, getGallery, getTestimonials, getFaqs } from '../lib/db.js';

// Mengambil data dinamis dari database (SSR)
const [products, gallery, testimonials, faqs] = await Promise.all([
  getProducts({ featuredOnly: true, activeOnly: true }),
  getGallery({ featuredOnly: true }),
  getTestimonials({ activeOnly: true }),
  getFaqs({ activeOnly: true })
]);
---

<BaseLayout
  title="Souvenir Kantor & Seminar Kit Custom Logo | seminarkit"
  description="Pesan souvenir kantor dan paket seminar kit custom logo. Pilihan tumbler stainless, notebook agenda kulit, tas kanvas, dan pulpen metal untuk seminar, workshop, dan acara perusahaan Anda."
>
  <!-- 1. Hero Section (Dua Kolom 7/5 Sesuai DESIGN.md) -->
  <section class="hero-section">
    <div class="container">
      <div class="row align-items-center g-5">
        <!-- Kolom Kiri: Teks & Headline Utama (7 Kolom di Desktop) -->
        <div class="col-12 col-lg-7">
          <span class="eyebrow">Souvenir Kantor & Seminar Kit</span>
          <h1 class="display-1 mb-3">
            Souvenir kantor dan seminar kit custom untuk acara perusahaan Anda
          </h1>
          <p class="lead-text prose-text mb-4">
            Penyedia merchandise korporat tepercaya dengan standar material premium, proses grafir logo presisi, dan komitmen waktu pengiriman tepat jadwal sebelum acara dimulai.
          </p>

          <div class="d-flex flex-wrap gap-3 mb-5">
            <a href="/produk" class="btn-sk">
              Lihat Katalog
            </a>
            <a
              href="https://wa.me/6282232730246?text=Halo%20seminarkit,%20saya%20ingin%20konsultasi%20paket%20seminar%20kit%20dan%20souvenir%20kantor"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-sk-outline"
            >
              Pesan via WhatsApp
            </a>
          </div>

          <!-- Tiga Angka Ringkas Pembuktian Kredibilitas -->
          <div class="d-flex align-items-center pt-4 border-line-top">
            <div class="stat-item">
              <div class="stat-number">500+</div>
              <div class="stat-label">Klien Korporat</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">8+</div>
              <div class="stat-label">Tahun Pengalaman</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">50+</div>
              <div class="stat-label">Pilihan Produk</div>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Foto Produk Besar (5 Kolom di Desktop) -->
        <div class="col-12 col-lg-5">
          <div class="hero-image-wrapper">
            <div class="hero-backdrop" aria-hidden="true"></div>
            <img
              src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=800&q=80"
              alt="Paket Seminar Kit Premium Hardbox Notebook dan Tumbler Custom Logo"
              class="hero-photo"
              width="600"
              height="750"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Section Tentang Singkat -->
  <section class="section-py bg-khaki-tint">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-12 col-lg-5 order-2 order-lg-1">
          <img
            src="https://images.unsplash.com/photo-1531346878377-a5be20888e57?auto=format&fit=crop&w=800&q=80"
            alt="Proses Kurasi dan Quality Control Souvenir Kantor seminarkit"
            class="border-line"
            style="aspect-ratio: 4/3; object-fit: cover; width: 100%;"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>

        <div class="col-12 col-lg-7 order-1 order-lg-2">
          <span class="eyebrow">Tentang seminarkit</span>
          <h2 class="title-with-bar mb-3">
            Standar Pengadaan Merchandise yang Membanggakan Instansi
          </h2>
          <p class="prose-text mb-3">
            Seminarkit hadir untuk menjawab tantangan panitia acara, bagian pengadaan (procurement), dan tim HRD yang sering kesulitan menemukan souvenir kantor berkualitas konsisten. Kami memadukan material pilihan dengan teknologi cetak modern seperti grafir laser, hotprint deboss, dan UV flatbed.
          </p>
          <p class="prose-text mb-4">
            Mulai dari rapat kerja internal, workshop berkala, pelatihan SDM, hingga simposium internasional berskala ribuan peserta, tim kami mendampingi dari tahap penentuan konsep, pembuatan sampel digital (mockup), hingga pengemasan akhir yang rapi dan aman.
          </p>
          <a href="/tentang" class="link-sk">
            Selengkapnya Tentang Kami
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Section Kenapa Pilih Kami (Nomor Besar, Tanpa Ikon) -->
  <section class="section-py bg-paper">
    <div class="container">
      <div class="row mb-5">
        <div class="col-12 col-lg-8">
          <span class="eyebrow">Keunggulan Layanan</span>
          <h2>Mengapa Perusahaan Mempercayakan Pesanan kepada Kami</h2>
          <p class="lead-text prose-text">
            Bekerja dengan tenggat waktu acara korporat menuntut kepastian mutu dan ketepatan distribusi. Kami memegang teguh tiga prinsip dasar dalam setiap pesanan.
          </p>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12 col-md-4">
          <div class="feature-step">
            <div class="step-number">01</div>
            <h3 class="mb-2">Kualitas Material Teruji</h3>
            <p class="text-small text-slate-soft prose-text">
              Kami hanya menggunakan tumbler stainless 304 food-grade, kertas bookpaper ramah mata, kulit sintetis tahan kelupas, dan kain kanvas tebal yang awet digunakan jangka panjang oleh peserta.
            </p>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="feature-step">
            <div class="step-number">02</div>
            <h3 class="mb-2">Cetak Logo Presisi & Rapi</h3>
            <p class="text-small text-slate-soft prose-text">
              Hasil grafir laser serat tajam hingga detail terkecil, sablon bebas luber dengan tinta tahan cuci, serta deboss cover buku yang tegas mempertegas wibawa logo korporat Anda.
            </p>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="feature-step">
            <div class="step-number">03</div>
            <h3 class="mb-2">Tepat Waktu Tanpa Kompromi</h3>
            <p class="text-small text-slate-soft prose-text">
              Jadwal produksi transparan dengan sistem kendali mutu ketat. Kami memastikan seluruh pesanan tiba di lokasi acara Anda minimal 1-2 hari sebelum jadwal seminar berlangsung.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Section Produk Unggulan Dinamis dari Database -->
  <section class="section-py bg-khaki-tint border-line-top">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
        <div>
          <span class="eyebrow">Katalog Pilihan</span>
          <h2 class="mb-2">Produk & Paket Seminar Kit Unggulan</h2>
          <p class="text-slate-soft prose-text mb-0">
            Pilihan paket dan cenderamata kantor yang paling sering dipesan oleh instansi pemerintah dan perusahaan swasta.
          </p>
        </div>
        <div>
          <a href="/produk" class="btn-sk-outline">
            Lihat Semua Produk
          </a>
        </div>
      </div>

      <div class="row g-4">
        {products.map((product) => (
          <div class="col-12 col-md-6 col-lg-4">
            <ProductCard product={product} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Section Galeri Hasil Produksi -->
  <section class="section-py bg-paper border-line-top">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
        <div>
          <span class="eyebrow">Dokumentasi Kerja</span>
          <h2 class="mb-2">Portofolio Hasil Produksi Nyata</h2>
          <p class="text-slate-soft prose-text mb-0">
            Foto autentik dari bengkel kerja kami. Klik pada foto untuk memperbesar tampilan detail pengerjaan.
          </p>
        </div>
        <div>
          <a href="/galeri" class="link-sk">
            Buka Semua Galeri
          </a>
        </div>
      </div>

      <GalleryGrid items={gallery} />
    </div>
  </section>

  <!-- 6. Section Testimoni Klien -->
  <Testimonials testimonials={testimonials} />

  <!-- 7. Section FAQ (Accordion Tanpa Chevron, Plus/Minus CSS) -->
  <section class="section-py bg-paper border-line-top">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
          <div class="mb-5 text-center text-lg-start">
            <span class="eyebrow">Tanya Jawab</span>
            <h2>Pertanyaan yang Sering Diajukan</h2>
            <p class="lead-text prose-text">
              Jawaban ringkas dan transparan seputar ketentuan minimal order, estimasi waktu pengerjaan, dan pengiriman.
            </p>
          </div>

          <Faq faqs={faqs} accordionId="homeFaqAccordion" />
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Section CTA -->
  <Cta />
</BaseLayout>

---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getPosts } from "../../lib/db.js";

const posts = await getPosts({ publishedOnly: false });
---

<AdminLayout title="Kelola Artikel Blog" activeNav="blog">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h4 mb-1">Daftar Artikel & Panduan</h2>
      <span class="text-small text-slate-soft">
        Kelola publikasi artikel pilar dan edukasi SEO website.
      </span>
    </div>
    <button type="button" class="btn-sk" id="btnOpenAddPost">
      Tulis Artikel Baru
    </button>
  </div>

  <div class="admin-card">
    <div class="table-responsive">
      <table class="table-sk">
        <thead>
          <tr>
            <th style="width: 35%;">Judul Artikel & Slug</th>
            <th style="width: 15%;">Penulis</th>
            <th style="width: 15%;">Tanggal</th>
            <th style="width: 15%;">Status</th>
            <th style="width: 20%;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr>
              <td>
                <div class="fw-bold">{post.title}</div>
                <div class="text-small text-slate-soft">/blog/{post.slug}</div>
              </td>
              <td class="text-small">{post.author || "Redaksi"}</td>
              <td class="text-small">
                {post.published_at
                  ? new Date(post.published_at).toLocaleDateString("id-ID", {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                    })
                  : "-"}
              </td>
              <td>
                <span class={`badge-status ${post.status}`}>
                  {post.status === "published" ? "Terbit" : "Draft"}
                </span>
              </td>
              <td>
                <button
                  type="button"
                  class="btn-action btn-action-edit btn-edit-post"
                  data-post={JSON.stringify(post)}
                >
                  Ubah
                </button>
                <button
                  type="button"
                  class="btn-action btn-action-delete btn-delete-post"
                  data-id={post.id}
                  data-title={post.title}
                >
                  Hapus
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Tambah / Ubah Artikel dengan File Picker Gambar -->
  <div
    class="modal fade"
    id="modalPostForm"
    tabindex="-1"
    aria-labelledby="modalPostLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-lg">
      <div
        class="modal-content border-line"
        style="border-radius: var(--radius);"
      >
        <div class="modal-header bg-slate text-white">
          <h3 class="modal-title h5" id="modalPostLabel">
            Formulir Artikel
          </h3>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="modal"
            aria-label="Tutup"
          ></button>
        </div>
        <form id="postForm">
          <div class="modal-body p-4">
            <input type="hidden" id="postId" />

            <div class="row g-3">
              <div class="col-12">
                <label for="postTitle" class="form-label-sk">
                  Judul Artikel *
                </label>
                <input
                  type="text"
                  id="postTitle"
                  class="form-control-sk"
                  required
                  placeholder="Contoh: Seminar Kit Adalah: Pengertian dan Manfaatnya"
                />
              </div>
              <div class="col-12">
                <label for="postSlug" class="form-label-sk">
                  Slug URL (Unik) *
                </label>
                <input
                  type="text"
                  id="postSlug"
                  class="form-control-sk"
                  required
                  placeholder="seminar-kit-adalah"
                />
              </div>

              <!-- File Picker untuk Foto Sampul Blog -->
              <div class="col-12">
                <label class="form-label-sk">
                  Foto Sampul Artikel (Cover Image) *
                </label>
                <input type="hidden" id="postImage" required />
                <input
                  type="file"
                  id="postFileInput"
                  accept="image/jpeg,image/png,image/webp"
                  style="display: none;"
                />

                <div class="upload-dropzone" id="dropzonePost">
                  <div id="postEmptyState">
                    <p class="fw-bold mb-1">Klik untuk memilih foto sampul</p>
                    <span class="text-small text-slate-soft d-block">
                      Maksimal 2 MB (JPG, PNG, WebP)
                    </span>
                    <button
                      type="button"
                      class="btn-sk mt-3"
                      style="padding: 0.5rem 1.25rem; font-size: 0.75rem;"
                      id="btnBrowsePost"
                    >
                      Pilih Berkas Foto
                    </button>
                  </div>

                  <div
                    id="postPreviewState"
                    class="d-none align-items-center justify-content-between p-2"
                  >
                    <div class="d-flex align-items-center gap-3">
                      <img
                        id="postPreviewImg"
                        src=""
                        alt="Pratinjau"
                        style="width: 80px; height: 50px; object-fit: cover;"
                        class="border-line"
                      />
                      <div class="text-start">
                        <div class="fw-bold text-small" id="postFileName">
                          cover.webp
                        </div>
                        <div
                          class="text-small text-khaki-deep"
                          id="postUploadStatus"
                        >
                          Foto tersimpan
                        </div>
                      </div>
                    </div>
                    <button
                      type="button"
                      class="btn-sk-outline"
                      style="padding: 0.35rem 0.75rem; font-size: 0.75rem;"
                      id="btnChangePost"
                    >
                      Ganti Foto
                    </button>
                  </div>
                </div>
              </div>

              <div class="col-12 col-md-6">
                <label for="postAuthor" class="form-label-sk">
                  Penulis *
                </label>
                <input
                  type="text"
                  id="postAuthor"
                  class="form-control-sk"
                  value="Tim Redaksi seminarkit"
                  required
                />
              </div>
              <div class="col-12 col-md-6">
                <label for="postStatus" class="form-label-sk">
                  Status Publikasi
                </label>
                <select id="postStatus" class="form-control-sk">
                  <option value="published">Terbit (Published)</option>
                  <option value="draft">Draft (Disembunyikan)</option>
                </select>
              </div>
              <div class="col-12">
                <label for="postExcerpt" class="form-label-sk">
                  Ringkasan Artikel (Excerpt) *
                </label>
                <textarea
                  id="postExcerpt"
                  class="form-control-sk"
                  rows="2"
                  required
                  placeholder="Ringkasan 2-3 baris untuk card katalog artikel..."
                ></textarea>
              </div>
              <div class="col-12">
                <label for="postContent" class="form-label-sk">
                  Isi Konten Artikel (HTML / Teks) *
                </label>
                <textarea
                  id="postContent"
                  class="form-control-sk"
                  rows="8"
                  required
                  placeholder="Tuliskan isi artikel lengkap di sini..."
                ></textarea>
              </div>
              <div class="col-12 col-md-6">
                <label for="postMetaTitle" class="form-label-sk">
                  SEO Meta Title (Opsional)
                </label>
                <input
                  type="text"
                  id="postMetaTitle"
                  class="form-control-sk"
                  placeholder="Judul khusus untuk Google..."
                />
              </div>
              <div class="col-12 col-md-6">
                <label for="postMetaDesc" class="form-label-sk">
                  SEO Meta Description (Opsional)
                </label>
                <input
                  type="text"
                  id="postMetaDesc"
                  class="form-control-sk"
                  placeholder="Deskripsi ringkas untuk snippet mesin pencari..."
                />
              </div>
            </div>
          </div>
          <div class="modal-footer p-3 bg-khaki-tint border-line-top">
            <button
              type="button"
              class="btn-sk-outline"
              data-bs-dismiss="modal"
            >
              Batal
            </button>
            <button type="submit" class="btn-sk" id="btnSavePost">
              Simpan Artikel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const postForm = document.getElementById("postForm") as HTMLFormElement;
      const btnAdd = document.getElementById("btnOpenAddPost");
      const postId = document.getElementById("postId") as HTMLInputElement;
      const postTitle = document.getElementById(
        "postTitle",
      ) as HTMLInputElement;
      const postSlug = document.getElementById("postSlug") as HTMLInputElement;
      const postImage = document.getElementById(
        "postImage",
      ) as HTMLInputElement;
      const postAuthor = document.getElementById(
        "postAuthor",
      ) as HTMLInputElement;
      const postStatus = document.getElementById(
        "postStatus",
      ) as HTMLSelectElement;
      const postExcerpt = document.getElementById(
        "postExcerpt",
      ) as HTMLTextAreaElement;
      const postContent = document.getElementById(
        "postContent",
      ) as HTMLTextAreaElement;
      const postMetaTitle = document.getElementById(
        "postMetaTitle",
      ) as HTMLInputElement;
      const postMetaDesc = document.getElementById(
        "postMetaDesc",
      ) as HTMLInputElement;
      const btnSave = document.getElementById(
        "btnSavePost",
      ) as HTMLButtonElement;

      // File upload handler
      const fileInput = document.getElementById(
        "postFileInput",
      ) as HTMLInputElement;
      const btnBrowse = document.getElementById("btnBrowsePost");
      const btnChange = document.getElementById("btnChangePost");
      const dropzone = document.getElementById("dropzonePost");
      const emptyState = document.getElementById("postEmptyState");
      const previewState = document.getElementById("postPreviewState");
      const previewImg = document.getElementById(
        "postPreviewImg",
      ) as HTMLImageElement;
      const fileNameDisplay = document.getElementById("postFileName");
      const uploadStatus = document.getElementById("postUploadStatus");

      function showPreview(url: string, name: string = "Foto terpilih") {
        if (url) {
          postImage.value = url;
          previewImg.src = url;
          if (fileNameDisplay) fileNameDisplay.textContent = name;
          if (uploadStatus) {
            uploadStatus.textContent = "Foto siap disimpan";
            uploadStatus.className = "text-small text-khaki-deep";
          }
          emptyState?.classList.add("d-none");
          previewState?.classList.remove("d-none");
          previewState?.classList.add("d-flex");
        } else {
          postImage.value = "";
          previewImg.src = "";
          emptyState?.classList.remove("d-none");
          previewState?.classList.add("d-none");
          previewState?.classList.remove("d-flex");
        }
      }

      btnBrowse?.addEventListener("click", (e) => {
        e.stopPropagation();
        fileInput?.click();
      });

      btnChange?.addEventListener("click", (e) => {
        e.stopPropagation();
        fileInput?.click();
      });

      dropzone?.addEventListener("click", () => {
        if (!postImage.value) fileInput?.click();
      });

      fileInput?.addEventListener("change", async () => {
        if (!fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];

        if (file.size > 2 * 1024 * 1024) {
          alert("Ukuran file melebihi batas maksimal 2 MB.");
          fileInput.value = "";
          return;
        }

        const reader = new FileReader();
        reader.onload = (e) => {
          showPreview(e.target?.result as string, file.name);
          if (uploadStatus) {
            uploadStatus.textContent = "Mengunggah ke penyimpanan...";
            uploadStatus.className = "text-small text-slate-soft";
          }
        };
        reader.readAsDataURL(file);

        const formData = new FormData();
        formData.append("file", file);

        try {
          const res = await fetch("/api/admin/upload", {
            method: "POST",
            body: formData,
          });
          const result = await res.json();

          if (result.success && result.url) {
            postImage.value = result.url;
            previewImg.src = result.url;
            if (uploadStatus) {
              uploadStatus.textContent = "Foto berhasil diunggah";
              uploadStatus.className = "text-small text-khaki-deep";
            }
          } else {
            alert(
              "Gagal mengunggah foto: " + (result.error || "Terjadi kesalahan"),
            );
            showPreview("");
          }
        } catch (err) {
          alert("Terjadi kendala jaringan.");
          showPreview("");
        }
      });

      // Auto generate slug
      postTitle?.addEventListener("input", () => {
        if (!postId.value) {
          postSlug.value = postTitle.value
            .toLowerCase()
            .replace(/[^\w\s-]/g, "")
            .replace(/[\s_-]+/g, "-")
            .replace(/^-+|-+$/g, "");
        }
      });

      // Tambah Post Baru
      btnAdd?.addEventListener("click", () => {
        postForm?.reset();
        postId.value = "";
        showPreview("");
        (document.getElementById("modalPostLabel") as HTMLElement).textContent =
          "Tulis Artikel Baru";
        // @ts-ignore
        window.skOpenModal("modalPostForm");
      });

      // Edit Post
      document.querySelectorAll(".btn-edit-post").forEach((btn) => {
        btn.addEventListener("click", () => {
          const data = JSON.parse(btn.getAttribute("data-post") || "{}");
          postId.value = data.id || "";
          postTitle.value = data.title || "";
          postSlug.value = data.slug || "";
          postAuthor.value = data.author || "Tim Redaksi seminarkit";
          postStatus.value = data.status || "published";
          postExcerpt.value = data.excerpt || "";
          postContent.value = data.content || "";
          postMetaTitle.value = data.meta_title || "";
          postMetaDesc.value = data.meta_description || "";

          showPreview(data.cover_image || "", "Foto Terpasang");

          (
            document.getElementById("modalPostLabel") as HTMLElement
          ).textContent = "Ubah Artikel: " + data.title;
          // @ts-ignore
          window.skOpenModal("modalPostForm");
        });
      });

      // Submit Post Form
      postForm?.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!postImage.value) {
          alert("Harap pilih foto sampul artikel.");
          return;
        }

        btnSave.disabled = true;
        btnSave.textContent = "Menyimpan...";

        const payload = {
          id: postId.value || undefined,
          title: postTitle.value,
          slug: postSlug.value,
          cover_image: postImage.value,
          author: postAuthor.value,
          status: postStatus.value,
          excerpt: postExcerpt.value,
          content: postContent.value,
          meta_title: postMetaTitle.value || undefined,
          meta_description: postMetaDesc.value || undefined,
        };

        try {
          const res = await fetch("/api/admin/post", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const result = await res.json();

          if (result.success) {
            // @ts-ignore
            window.skCloseModal("modalPostForm");
            window.location.reload();
          } else {
            alert(
              "Gagal menyimpan artikel: " +
                (result.error || "Terjadi kesalahan"),
            );
            btnSave.disabled = false;
            btnSave.textContent = "Simpan Artikel";
          }
        } catch (err) {
          alert("Terjadi kesalahan jaringan.");
          btnSave.disabled = false;
          btnSave.textContent = "Simpan Artikel";
        }
      });

      // Delete Post
      document.querySelectorAll(".btn-delete-post").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-id");
          const title = btn.getAttribute("data-title");
          if (
            confirm(`Apakah Anda yakin ingin menghapus artikel "${title}"?`)
          ) {
            try {
              const res = await fetch("/api/admin/post", {
                method: "DELETE",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id }),
              });
              const result = await res.json();
              if (result.success) {
                window.location.reload();
              } else {
                alert(
                  "Gagal menghapus artikel: " +
                    (result.error || "Terjadi kesalahan"),
                );
              }
            } catch (err) {
              alert("Terjadi kesalahan jaringan.");
            }
          }
        });
      });
    });
  </script>
</AdminLayout>

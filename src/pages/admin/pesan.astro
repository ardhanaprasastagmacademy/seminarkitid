---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getMessages } from '../../lib/db.js';

const messages = await getMessages();
---

<AdminLayout title="Pesan Masuk" activeNav="pesan">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h4 mb-1">Daftar Formulir Kontak & Permintaan Penawaran</h2>
      <span class="text-small text-slate-soft">Pesan dari calon pelanggan yang masuk melalui halaman kontak website.</span>
    </div>
  </div>

  <div class="admin-card">
    {messages.length === 0 ? (
      <div class="p-5 text-center bg-khaki-tint border-line">
        <p class="mb-0 text-slate-soft">Belum ada pesan masuk di database.</p>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="table-sk">
          <thead>
            <tr>
              <th style="width: 15%;">Tanggal</th>
              <th style="width: 20%;">Pengirim</th>
              <th style="width: 20%;">Kontak</th>
              <th style="width: 25%;">Subjek & Pesan</th>
              <th style="width: 10%;">Status</th>
              <th style="width: 10%;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            {messages.map((msg) => (
              <tr class={msg.status === 'baru' ? 'fw-bold' : ''}>
                <td class="text-small">
                  {new Date(msg.created_at).toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                  })}
                </td>
                <td>{msg.name}</td>
                <td>
                  <div class="text-small">{msg.phone}</div>
                  <div class="text-small text-slate-soft fw-normal">{msg.email}</div>
                </td>
                <td>
                  <div class="text-small">{msg.subject || "(Tanpa Subjek)"}</div>
                  <div class="text-small text-slate-soft fw-normal text-truncate" style="max-width: 260px;">
                    {msg.message}
                  </div>
                </td>
                <td>
                  <span class={`badge-status ${msg.status}`}>
                    {msg.status === 'baru' ? 'Baru' : 'Dibaca'}
                  </span>
                </td>
                <td>
                  <button
                    type="button"
                    class="btn-action btn-action-edit btn-view-msg"
                    data-message={JSON.stringify(msg)}
                  >
                    Buka
                  </button>
                  <button
                    type="button"
                    class="btn-action btn-action-delete btn-del-msg"
                    data-id={msg.id}
                  >
                    Hapus
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- Modal Detail Pesan Masuk Sesuai PRD Bagian 9 -->
  <div class="modal fade" id="modalMessageDetail" tabindex="-1" aria-labelledby="modalMsgLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content border-line" style="border-radius: var(--radius);">
        <div class="modal-header bg-slate text-white">
          <h3 class="modal-title h5" id="modalMsgLabel">Detail Pesan Masuk</h3>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row g-3 mb-4">
            <div class="col-12 col-md-6">
              <span class="eyebrow" style="font-size: 0.6875rem;">Pengirim</span>
              <div class="fw-bold" id="msgDetailName"></div>
            </div>
            <div class="col-12 col-md-6">
              <span class="eyebrow" style="font-size: 0.6875rem;">Waktu Masuk</span>
              <div id="msgDetailDate"></div>
            </div>
            <div class="col-12 col-md-6">
              <span class="eyebrow" style="font-size: 0.6875rem;">Nomor Telepon / WhatsApp</span>
              <div id="msgDetailPhone"></div>
            </div>
            <div class="col-12 col-md-6">
              <span class="eyebrow" style="font-size: 0.6875rem;">Alamat Email</span>
              <div id="msgDetailEmail"></div>
            </div>
            <div class="col-12">
              <span class="eyebrow" style="font-size: 0.6875rem;">Subjek Pesan</span>
              <div class="fw-bold" id="msgDetailSubject"></div>
            </div>
          </div>

          <div class="p-3 bg-paper border-line mb-4">
            <span class="eyebrow" style="font-size: 0.6875rem;">Isi Pesan</span>
            <p id="msgDetailText" class="mb-0 prose-text" style="white-space: pre-line;"></p>
          </div>

          <!-- Tombol Balas Cepat Sesuai PRD Bagian 9 (WhatsApp atau Email) -->
          <div class="d-flex flex-wrap gap-2">
            <a href="#" target="_blank" rel="noopener noreferrer" class="btn-sk" id="btnReplyWa">
              Balas via WhatsApp
            </a>
            <a href="#" class="btn-sk-outline" id="btnReplyEmail">
              Balas via Email
            </a>
            <button type="button" class="btn-sk-outline" id="btnMarkRead">
              Tandai Sudah Dibaca
            </button>
          </div>
        </div>
        <div class="modal-footer p-3 bg-khaki-tint border-line-top">
          <button type="button" class="btn-sk-outline" data-bs-dismiss="modal">Tutup</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      let currentMsgId = '';

      document.querySelectorAll('.btn-view-msg').forEach((btn) => {
        btn.addEventListener('click', () => {
          const msg = JSON.parse(btn.getAttribute('data-message') || '{}');
          currentMsgId = msg.id;

          (document.getElementById('msgDetailName') as HTMLElement).textContent = msg.name || '';
          (document.getElementById('msgDetailDate') as HTMLElement).textContent = new Date(msg.created_at).toLocaleString('id-ID');
          (document.getElementById('msgDetailPhone') as HTMLElement).textContent = msg.phone || '';
          (document.getElementById('msgDetailEmail') as HTMLElement).textContent = msg.email || '';
          (document.getElementById('msgDetailSubject') as HTMLElement).textContent = msg.subject || '-';
          (document.getElementById('msgDetailText') as HTMLElement).textContent = msg.message || '';

          // Format nomor WA (ganti awalan 0 menjadi 62)
          let cleanPhone = (msg.phone || '').replace(/\D/g, '');
          if (cleanPhone.startsWith('0')) cleanPhone = '62' + cleanPhone.slice(1);

          const waBtn = document.getElementById('btnReplyWa') as HTMLAnchorElement;
          waBtn.href = `https://wa.me/${cleanPhone}?text=Halo%20${encodeURIComponent(msg.name)},%20terima%20kasih%20telah%20menghubungi%20seminarkit%20mengenai%20${encodeURIComponent(msg.subject || 'kebutuhan souvenir')}.`;

          const emailBtn = document.getElementById('btnReplyEmail') as HTMLAnchorElement;
          emailBtn.href = `mailto:${msg.email}?subject=Re:%20${encodeURIComponent(msg.subject || 'Permintaan Souvenir seminarkit')}`;

          // @ts-ignore
          window.skOpenModal('modalMessageDetail');

          // Auto mark as read jika status masih baru
          if (msg.status === 'baru') {
            fetch('/api/admin/message', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: msg.id, status: 'dibaca' })
            });
          }
        });
      });

      document.getElementById('btnMarkRead')?.addEventListener('click', async () => {
        if (!currentMsgId) return;
        try {
          await fetch('/api/admin/message', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: currentMsgId, status: 'dibaca' })
          });
          // @ts-ignore
          window.skCloseModal('modalMessageDetail');
          window.location.reload();
        } catch (e) {
          alert('Gagal menandai pesan.');
        }
      });

      document.querySelectorAll('.btn-del-msg').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (confirm('Hapus pesan ini dari inbox?')) {
            try {
              const res = await fetch('/api/admin/message', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
              });
              const result = await res.json();
              if (result.success) {
                window.location.reload();
              } else {
                alert('Gagal menghapus pesan.');
              }
            } catch (err) {
              alert('Terjadi kesalahan jaringan.');
            }
          }
        });
      });
    });
  </script>
</AdminLayout>
